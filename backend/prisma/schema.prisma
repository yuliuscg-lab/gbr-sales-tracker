generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  password         String
  phone            String         @unique
  name             String
  role             Role           @default(CUSTOMER)
  refCode          String?        @unique @map("ref_code")
  refCodeInput     String?        @map("ref_code_input")
  balancePoints    Int            @default(0) @map("balance_points")
  refById          String?        @map("ref_by")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")
  refreshTokens    RefreshToken[]
  events           Event[]
  pointBuckets     PointsBucket[]
  pointLedgers     PointsLedger[]
  profile          Profile?
  salesOrders      SalesOrder[]
  refBy            User?          @relation("UserReferral", fields: [refById], references: [id])
  referrals        User[]         @relation("UserReferral")
  verifiedPayments Payment[]      @relation("PaymentVerifier")
  coupons          Coupon[]

  @@map("users")
}

model Profile {
  id        String    @id @default(cuid())
  dob       DateTime?
  nik       String?    @unique
  gender    String?
  avatarUrl String?    @map("avatar_url")
  userId    String    @unique @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  user      User      @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model Event {
  id           String       @id @default(cuid())
  eventTitle   String       @unique
  eventDate    DateTime     @map("event_date")
  startTime    DateTime     @map("start_time")
  endTime      DateTime     @map("end_time")
  eventDesc    String       @map("event_desc")
  thumbnailUrl String?      @map("thumbnail_url")
  eventTnc     String       @map("event_tnc")
  lastBuyAt    DateTime     @map("last_buy_at")
  status       EventStatus  @map("status")
  categoryId   Int          @map("category_id")
  venueId      Int          @map("venue_id")
  organizerId  String       @map("organizer_id")
  category     Category     @relation(fields: [categoryId], references: [id])
  organizer    User         @relation(fields: [organizerId], references: [id])
  venue        Venue        @relation(fields: [venueId], references: [id])
  ticketTypes  TicketType[]
  salesOrders  SalesOrder[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([organizerId])
  @@index([categoryId])
  @@index([venueId])
  @@index([status])
  @@index([eventDate])
  @@map("events")
}

model Category {
  id        Int       @id @default(autoincrement())
  category  String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  events    Event[]

  @@map("categories")
}

model PointsLedger {
  id               Int                     @id @default(autoincrement())
  amount           Int
  transactionType  TransactionType         @map("transaction_type")
  source           EarnSource?
  sourceId         String?                 @map("source_id")
  customerId       String                  @map("customer_id")
  deductionDetails PointsDeductionDetail[]
  customer         User                    @relation(fields: [customerId], references: [id])
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("points_ledgers")
}

model PointsBucket {
  id               Int                     @id @default(autoincrement())
  earned           Int
  remaining        Int
  expiredAt        DateTime                @map("expired_at")
  earnedAt         DateTime                @default(now()) @map("earned_at")
  customerId       String                  @map("customer_id")
  customer         User                    @relation(fields: [customerId], references: [id])
  deductionDetails PointsDeductionDetail[]
  reservations     PointsReservation[]

  @@index([customerId])
  @@index([expiredAt])
  @@map("points_buckets")
}

model PointsDeductionDetail {
  id             Int          @id @default(autoincrement())
  ledgerId       Int          @map("ledger_id")
  bucketId       Int          @map("bucket_id")
  amountRedeemed Int          @map("amount_redeemed")
  bucket         PointsBucket @relation(fields: [bucketId], references: [id])
  ledger         PointsLedger @relation(fields: [ledgerId], references: [id])

  @@index([ledgerId])
  @@index([bucketId])
  @@map("points_deduction_details")
}

model PointsReservation {
  id              Int          @id @default(autoincrement())
  bucketId        Int          @map("bucket_id")
  bucket          PointsBucket @relation(fields: [bucketId], references: [id])
  salesOrderId    String       @map("sales_order_id")
  salesOrder      SalesOrder   @relation(fields: [salesOrderId], references: [id])
  amount          Int
  
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  
  @@index([salesOrderId])
  @@index([bucketId])
  @@map("points_reservations")
}

model Coupon {
  id              Int          @id @default(autoincrement())
  customerId      String       @map("customer_id")
  customer        User         @relation(fields: [customerId], references: [id])
  couponCode      String       @unique @map("coupon_code")
  discountPercent Int          @default(10) @map("discount_percent")
  isUsed          Boolean      @default(false) @map("is_used")
  usedInOrderId   String?      @map("used_in_order_id")
  usedAt          DateTime?    @map("used_at")
  expiredAt       DateTime     @map("expired_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")
  salesOrders     SalesOrder[]

  @@index([customerId])
  @@map("coupons")
}

model Venue {
  id            Int       @id @default(autoincrement())
  venueName     String    @unique @map("venue_name")
  venueAddress  String    @map("venue_address")
  venueCity     String    @map("venue_city")
  venueState    String    @map("venue_state")
  venueZipCode  String    @map("venue_zip_code")
  venuePhone    String    @map("venue_phone")
  venueEmail    String    @map("venue_email")
  venueGMapsUrl String    @map("venue_gmaps_url")
  capacity      Int
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  events        Event[]

  @@map("venues")
}

model SalesOrder {
  id            String           @id @default(cuid())
  invoiceNumber String           @unique @map("invoice_number")
  customer      User             @relation(fields: [customerId], references: [id])
  customerId    String           @map("customer_id")
  eventId       String           @map("event_id")
  event         Event            @relation(fields: [eventId], references: [id])
  ticketTypeId  Int              @map("ticket_type_id")
  ticketType    TicketType       @relation(fields: [ticketTypeId], references: [id])
  couponId      Int?             @map("coupon_id")
  coupon        Coupon?          @relation(fields: [couponId], references: [id])
  payment       Payment?
  ticketName    String           @map("ticket_name")
  ticketPrice   Int              @map("ticket_price")
  qtyTickets    Int              @map("qty_tickets")
  couponCode    String?          @map("coupon_code")
  totalPrice    Int              @map("total_price")
  totalDiscount Int              @default(0) @map("total_discount")
  pointsUsed    Int              @default(0) @map("points_used")
  finalPrice    Int              @map("final_price")
  status        SalesOrderStatus @default(WAITING_PAYMENT)
  issuedTickets IssuedTicket[]
  pointsReservations PointsReservation[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")

  @@index([createdAt])
  @@index([customerId])
  @@index([eventId])
  @@index([ticketTypeId])
  @@index([status])
  @@map("sales_orders")
}

model TicketType {
  id            Int            @id @default(autoincrement())
  ticketType    String
  price         Int
  quota         Int
  sold          Int?           @default(0)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  eventId       String         @map("event_id")
  issuedTickets IssuedTicket[]
  event         Event          @relation(fields: [eventId], references: [id])
  salesOrder    SalesOrder[]

  @@unique([eventId, ticketType])
  @@index([eventId])
  @@map("ticket_types")
}

model IssuedTicket {
  id           String     @id @default(cuid())
  ticketCode   String     @unique @map("ticket_code")
  isUsed       Boolean    @default(false) @map("is_used")
  usedAt       DateTime?  @map("used_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  ticketTypeId Int        @map("ticket_type_id")
  salesOrderId String     @map("sales_order_id")
  ticketName   String     @map("ticket_name")
  ticketPrice  Int        @map("ticket_price")
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([salesOrderId])
  @@index([ticketCode])
  @@map("issued_tickets")
}

model Payment {
  id            String        @id @default(cuid())
  salesOrderId  String        @unique @map("sales_order_id")
  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id])
  amount        Int
  paymentMethod PaymentMethod @map("payment_method")
  paymentProof  String?       @map("payment_proof")
  paidAt        DateTime?     @map("paid_at")
  expiredAt     DateTime      @map("expired_at")
  status        PaymentStatus @default(WAITING_UPLOAD)
  rejectReason  String?       @map("reject_reason")
  verifiedById  String?       @map("verified_by_id")
  verifiedBy    User?         @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  verifiedAt    DateTime?     @map("verified_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

model RefreshToken {
  id        String    @id @default(cuid())
  jti       String    @unique
  tokenHash String    @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime?

  @@map("refresh_tokens")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Role {
  CUSTOMER
  ORGANIZER
  ADMIN
}

enum EarnSource {
  REFERRAL
  SALES_ORDER
}

enum TransactionType {
  EARN
  REDEEM
  EXPIRED
}

enum SalesOrderStatus {
  WAITING_PAYMENT
  PAID
  CANCELLED
  CANCELLED_EXPIRED
  REFUNDED
}

enum PaymentStatus {
  WAITING_UPLOAD
  WAITING_VERIFICATION
  VERIFIED
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  BANK_TRANSFER
}
