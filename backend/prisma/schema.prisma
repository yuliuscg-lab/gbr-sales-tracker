generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  password      String
  name          String
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  refreshTokens RefreshToken[]

  @@map("users")
}

model Customer {
  id                String  @id @default(cuid())
  name              String
  phone             String?
  totalOrders       Int     @default(0) @map("total_orders")
  unpaidOrdersCount Int     @default(0) @map("unpaid_orders_count")
  notes             String?

  address     String?
  subdistrict String?
  district    String?
  city        String?
  province    String?
  mapsUrl     String? @map("maps_url")

  customPrices CustomerProductPrice[]
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  deletedAt    DateTime?              @map("deleted_at")

  orders Order[]

  @@index([name])
  @@map("customers")
}

model Order {
  id           String    @id @default(cuid())
  customer     Customer  @relation(fields: [customerId], references: [id])
  customerId   String    @map("customer_id")
  orderNo      String    @unique @map("order_no")
  deliveryFee  Int       @default(0) @map("delivery_fee")
  totalAmount  Int       @map("total_amount")
  paidAmount   Int       @default(0) @map("paid_amount")
  dueDate      DateTime? @map("due_date")
  notes        String?
  deliveryDate DateTime  @default(now()) @map("delivery_date")

  shippedAt    DateTime? @map("shipped_at")
  orderDate    DateTime  @default(now()) @map("order_date")
  cancelReason String?   @map("cancel_reason")

  deliveryStatus   DeliveryStatus  @default(NOT_SHIPPED) @map("delivery_status")
  productionCardId String?         @map("production_card_id")
  productionCard   ProductionCard? @relation(fields: [productionCardId], references: [id], onDelete: SetNull)
  status           OrderStatus     @default(UNPAID)
  items            OrderItem[]
  payments         Payment[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  cancelledAt DateTime? @map("cancelled_at")

  @@index([deliveryStatus, productionCardId])
  @@index([customerId])
  @@index([status])
  @@index([orderNo])
  @@map("orders")
}

model Product {
  id               String    @id @default(cuid())
  code             String    @unique
  name             String    @unique
  baseUnit         String
  isProductionItem Boolean   @default(true) @map("is_production_item")
  costPrice        Int       @default(0) @map("cost_price")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  units      ProductUnit[]
  orderItems OrderItem[]

  @@index([code])
  @@index([name])
  @@index([isProductionItem])
  @@index([deletedAt])
  @@map("products")
}

model ProductUnit {
  id             String                 @id @default(cuid())
  product        Product                @relation(fields: [productId], references: [id])
  productId      String                 @map("product_id")
  unitName       String
  conversionQty  Int
  customerPrices CustomerProductPrice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_units")
}

model CustomerProductPrice {
  id            String      @id @default(cuid())
  customerId    String      @map("customer_id")
  customer      Customer    @relation(fields: [customerId], references: [id])
  productUnitId String
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [id])
  price         Int
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([customerId, productUnitId])
  @@index([customerId])
  @@index([productUnitId])
  @@map("customer_product_prices")
}

model OrderItem {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String @map("order_id")

  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?

  name             String
  unitName         String
  quantity         Int
  conversionQty    Int
  baseQty          Int
  unitPrice        Int    @map("unit_price")
  costPrice        Int    @default(0) @map("cost_price")
  subTotal         Int    @map("sub_total")
  isProductionItem Boolean @default(true) @map("is_production_item")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id            String        @id @default(cuid())
  order         Order         @relation(fields: [orderId], references: [id])
  orderId       String        @map("order_id")
  receiptNo     String?       @unique @map("receipt_no")
  amount        Int
  paymentMethod PaymentMethod @map("payment_method")
  paymentDate   DateTime      @default(now()) @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  deletedAt     DateTime?     @map("deleted_at")
  notes         String?

  @@index([orderId])
  @@index([paymentDate])
  @@index([deletedAt])
  @@map("payments")
}

model RefreshToken {
  id        String    @id @default(cuid())
  jti       String    @unique
  tokenHash String    @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime?

  @@map("refresh_tokens")
}

model Expense {
  id          String      @id @default(cuid())
  amount      Int
  expenseDate DateTime    @default(now()) @map("expense_date")
  type        ExpenseType @default(OPERATIONAL) @map("expense_type")
  category    String
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([expenseDate])
  @@index([type])
  @@map("expenses")
}

model ProductionCard {
  id        String   @id @default(cuid())
  cardNo    String   @unique @map("card_no")
  createdAt DateTime @default(now()) @map("created_at")
  notes     String?
  orders    Order[]

  @@index([createdAt])
  @@map("production_cards")
}

enum OrderStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
  CANCELLED
}

enum PaymentMethod {
  TRANSFER
  CASH
}

enum ExpenseType {
  OPERATIONAL
  MATERIAL
}

enum DeliveryStatus {
  NOT_SHIPPED
  SHIPPED
}
